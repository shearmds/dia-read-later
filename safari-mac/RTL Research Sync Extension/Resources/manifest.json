{
  "manifest_version": 3,
  "name": "Research Sync",
  "version": "2.5",
  "description": "Save pages to read later, right from your toolbar.",
  "permissions": ["activeTab", "storage", "tabs", "alarms", "favicon", "scripting"],
  "host_permissions": ["https://readlater-sync.shearm.workers.dev/*", "<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Save to Research Sync"
  },
  "commands": {
    "save-page": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Save current page to Research Sync"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
