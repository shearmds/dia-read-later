{
  "manifest_version": 3,
  "name": "Clipfile",
  "version": "2.6",
  "description": "Save pages to read later, right from your toolbar.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "alarms",
    "favicon",
    "scripting"
  ],
  "host_permissions": [
    "https://readlater-sync.shearm.workers.dev/*",
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Save to Clipfile"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "save-page": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Save current page to Clipfile"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
